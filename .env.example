# TAT Guardian (CONCORD AI) Environment Configuration

# Server Config
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=concord_user
POSTGRES_PASSWORD=concord_secret
POSTGRES_DB=concord_tat_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://concord_user:concord_secret@localhost:5432/concord_tat_db

# LLM Configuration (Configurable Provider)
LLM_PROVIDER=openai # openai, anthropic, or mock
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o

# Mock Fintech Settings
MOCK_BANK_LATENCY_MS=100
MOCK_SIMULATE_DELAYS=false

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
